{
  "name": "@kitchen/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "orval": "8.38.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate": "orval --config orval.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export": "expo export --platform android --platform ios --output-dir dist",
    "prebuild": "expo prebuild",
    "mobile:start": "npm run start --",
    "mobile:android": "npm run android --",
    "mobile:ios": "npm run ios --",
    "mobile:generate": "npm run generate --",
    "mobile:typecheck": "npm run typecheck --",
    "mobile:lint": "npm run lint --",
    "mobile:export": "npm run export --",
    "mobile:prebuild": "npm run prebuild --",
    "test": "jest --runInBand",
    "mobile:test": "npm run test --"
  },
  "private": true
}
