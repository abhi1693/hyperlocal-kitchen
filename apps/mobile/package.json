{
  "name": "@kitchen/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "orval": "8.44.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "generate": "orval --config orval.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "export": "expo export --platform android --platform ios --output-dir dist",
    "prebuild": "expo prebuild",
    "mobile:start": "npm run start --",
    "mobile:android": "npm run android --",
    "mobile:ios": "npm run ios --",
    "mobile:generate": "npm run generate --",
    "mobile:typecheck": "npm run typecheck --",
    "mobile:lint": "npm run lint --",
    "mobile:export": "npm run export --",
    "mobile:prebuild": "npm run prebuild --",
    "test": "jest --runInBand",
    "mobile:test": "npm run test --"
  },
  "private": true
}
