# Compose automatically combines services with local build/watch rules.
COMPOSE_FILE=compose.yaml:compose.build.yaml
POSTGRES_PASSWORD=replace-with-a-random-hex-password
KITCHEN_BIND_IP=0.0.0.0
KITCHEN_API_PORT=18000
KITCHEN_ADMIN_API_PORT=13001
KITCHEN_ADMIN_WEB_PORT=3001
KITCHEN_POSTGRES_PORT=15432
KITCHEN_REDIS_PORT=16379

KITCHEN_ENVIRONMENT=development
# Host-side URLs for uv/Python commands. Compose uses postgres/redis internally.
KITCHEN_DATABASE_URL=postgresql+psycopg://kitchen:${POSTGRES_PASSWORD}@127.0.0.1:${KITCHEN_POSTGRES_PORT}/kitchen
KITCHEN_REDIS_URL=redis://127.0.0.1:${KITCHEN_REDIS_PORT}/0
KITCHEN_PUSH_ENABLED=false
KITCHEN_PENDING_ORDER_MINUTES=15
KITCHEN_WORKER_POLL_SECONDS=5
KITCHEN_USER_BASE_URL=http://localhost:${KITCHEN_API_PORT}
KITCHEN_ADMIN_BASE_URL=http://localhost:${KITCHEN_ADMIN_WEB_PORT}
KITCHEN_COOKIE_SECURE=false

# Dedicated resident and administrator OIDC applications in Zitadel.
KITCHEN_OIDC_ISSUER_URL=
KITCHEN_OIDC_ORGANIZATION_ID=
KITCHEN_USER_OIDC_CLIENT_ID=
KITCHEN_ADMIN_OIDC_CLIENT_ID=
KITCHEN_ADMIN_REQUIRED_ROLE=platform_admin
KITCHEN_OIDC_TOKEN_ENDPOINT_AUTH_METHOD=none
KITCHEN_USER_OIDC_CLIENT_SECRET=
KITCHEN_ADMIN_OIDC_CLIENT_SECRET=
KITCHEN_OIDC_GOOGLE_IDP_ID=
KITCHEN_OIDC_GITHUB_IDP_ID=
